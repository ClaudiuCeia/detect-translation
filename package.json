{
  "name": "detect-translation",
  "version": "0.4.3",
  "description": "Trigger code when people translate your website",
  "keywords": [
    "translation",
    "detect",
    "detector",
    "language",
    "baidu fanyi",
    "bing translate",
    "google translate",
    "microsoft translator",
    "yandex translate",
    "naver papago"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "unpkg": "dist-browser/index.min.js",
  "jsdelivr": "dist-browser/index.min.js",
  "author": "Claudiu Ceia",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://github.com/ClaudiuCeia/detect-translation#readme",
  "bugs": {
    "url": "https://github.com/ClaudiuCeia/detect-translation/issues"
  },
  "type": "commonjs",
  "packageManager": "pnpm@11.24.0",
  "files": [
    "dist",
    "dist-browser"
  ],
  "scripts": {
    "build": "pnpm run langids && rimraf dist dist-browser && pnpm run build:module && pnpm run build:types && pnpm run build:browser",
    "build:module": "esbuild src/index.ts --bundle --platform=node --target=es2020 --sourcemap --format=esm --outfile=dist/index.mjs && esbuild src/index.ts --bundle --platform=node --target=es2020 --sourcemap --format=cjs --outfile=dist/index.cjs",
    "build:types": "tsc -p tsconfig.build.json && node -e \"const fs=require('node:fs');fs.copyFileSync('dist/index.d.ts','dist/index.d.cts');fs.writeFileSync('dist/index.d.mts','export * from \\\"./index.cjs\\\";\\n')\"",
    "build:browser": "esbuild src/index.ts --bundle --format=iife --global-name=DetectTranslation --target=es2020 --minify --sourcemap --outfile=dist-browser/index.min.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm run langids && jest",
    "e2e:only": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e": "pnpm run build && pnpm run e2e:only",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "knip": "knip",
    "package-smoke": "pnpm run build && tsx ./.bin/packageSmoke.ts",
    "security:audit": "pnpm audit --audit-level high",
    "verify": "pnpm test && pnpm run lint && pnpm run typecheck && pnpm run knip && pnpm run package-smoke && pnpm run package-check && pnpm run security:audit",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "langids": "tsx ./.bin/writeLangIds.ts",
    "package-check": "publint"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ClaudiuCeia/detect-translation.git"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.16.1",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "cldr": "^8.0.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "js-yaml": "5.4.1",
    "knip": "^6.33.0",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
