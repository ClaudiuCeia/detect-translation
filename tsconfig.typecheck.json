{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["jest", "node"]
  },
  "include": [
    "src/**/*.ts",
    ".bin/**/*.ts",
    "e2e/**/*.ts",
    "setup-jest.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "dist-browser", "node_modules"]
}
